{
  "type": "object",
  "properties": {
    "vars": { "$ref": "#/$defs/vars" },
    "env": { "$ref": "#/$defs/env" },
    "steps": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "run": {"type": "string"},
            "vars": { "$ref": "#/$defs/vars" },
            "env": { "$ref": "#/$defs/env" },
            "after": {
              "anyOf": [
                {"type": "string"},
                {
                  "type": "array",
                  "items": {"type": "string"}
                }
              ]
            },
            "when": {
              "anyOf": [
                {"type": "string"},
                {
                  "type": "array",
                  "items": {"type": "string"}
                }
              ]
            }
          },
          "required": ["run"],
          "additionalProperties": false
        }
      }
    }
  },
  "required": ["steps"],
  "additionalProperties": false,
  "$defs": {
    "env": {
      "type": "object",
      "additionalProperties": true
    },
    "vars": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
