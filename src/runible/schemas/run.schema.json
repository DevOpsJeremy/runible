{
  "type": "object",
  "properties": {
    "vars": { "$ref": "#/$defs/vars" },
    "env": { "$ref": "#/$defs/env" },
    "tags": { "$ref": "#/$defs/tags" },
    "interface": {
      "type": "string",
      "default": "default",
      "description": "Name of the interface plugin (entry point in group 'runible')."
    },
    "steps": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "run": {"type": "string"},
            "vars": { "$ref": "#/$defs/vars" },
            "env": { "$ref": "#/$defs/env" },
            "tags": { "$ref": "#/$defs/tags" },
            "after": {
              "anyOf": [
                {"type": "string"},
                {
                  "type": "array",
                  "items": {"type": "string"}
                }
              ]
            },
            "when": {
              "anyOf": [
                {"type": "string"},
                {
                  "type": "array",
                  "items": {"type": "string"}
                }
              ]
            }
          },
          "required": ["run"],
          "additionalProperties": false
        }
      }
    }
  },
  "required": ["steps"],
  "additionalProperties": false,
  "$defs": {
    "env": {
      "type": "object",
      "additionalProperties": true
    },
    "vars": {
      "type": "object",
      "additionalProperties": true
    },
    "tags": {
      "anyOf": [
        {"type": "string"},
        {
          "type": "array",
          "items": {"type": "string"}
        }
      ]
    }
  }
}
